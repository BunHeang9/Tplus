

DB_SERVER=127.0.0.1
DB_DATABASE=Tplus
DB_USER=tplus_api
DB_PASSWORD=your_password_here
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

PORT=3000

# New self-service signups wait for an admin to approve them before they can
# log in. Set to false for open signup - but note the API is reachable from
# the internet, so anyone with the URL could then read the whole inventory.
REQUIRE_ADMIN_APPROVAL=true
