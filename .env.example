

DB_SERVER=127.0.0.1
DB_DATABASE=Tplus
DB_USER=tplus_api
DB_PASSWORD=your_password_here
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

PORT=3000

# New self-service signups wait for an admin to approve them before they can
# log in. Set to false for open signup - but note the API is reachable from
# the internet, so anyone with the URL could then read the whole inventory.
REQUIRE_ADMIN_APPROVAL=true

# Which site(s) a browser is allowed to call this API from. Comma-separated
# for more than one origin (e.g. a staging frontend and a production one).
# Left unset, any origin is allowed - fine while developing against a
# frontend whose URL isn't fixed yet, but set this once it is.
# CORS_ORIGIN=https://tplus.example.com

# Used to build the link inside a password-reset email
# (FRONTEND_URL/reset-password?token=...). Left unset, that falls back to
# this API's own PORT above - fine for testing the flow with the console-
# logged fallback link (see SMTP_HOST below), but set this to the real
# frontend's address once it's fixed, or the link in a real email will
# point at the backend instead of the page that actually handles it.
# FRONTEND_URL=https://tplus.example.com

# SMTP settings for password-reset emails. Left unset (just SMTP_HOST is
# enough to count as "configured"), reset links are logged to the console
# instead of actually emailed - useful for developing/testing the flow
# locally, but real values are needed before an actual user ever receives
# a real email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@tplus.example.com
